# Copy this file to secrets.yaml in this directory.
# Replace each CHANGE_ME value with your own value.
# Git ignores secrets.yaml. Never commit it.

wifi_ssid: "CHANGE_ME"
wifi_password: "CHANGE_ME"

# Password of the fallback access point (harvesp-debug.yaml only).
fallback_ap_password: "CHANGE_ME"

ota_password: "CHANGE_ME"

# A 32-byte key in base64. Make one with: openssl rand -base64 32
api_encryption_key: "CHANGE_ME"
